# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Tests ----
.pytest_cache/

# ---- Data (never commit; ONE caches to disk, can reach many GB) ----
# Leading slash = repo root only. WITHOUT it, this pattern also swallows src/data/.
# Keep the empty data/ folder in the tree, ignore everything downloaded into it.
/data/**
!/data/
!/data/.gitkeep
# ONE caches also land OUTSIDE repo-root data/ when a notebook sets a relative cache dir
# (e.g. notebooks/data/ONE is ~500 MB). Ignore ONE caches wherever they appear. These are
# specific enough to never touch src/data/ (which has no ONE/ subdir).
**/data/ONE/
/notebooks/data/
*.pqt
*.npy
*.nwb

# ---- Results: keep the folder structure, ignore heavy/generated artefacts ----
# Plots (png/pdf/svg) and CSVs are regenerated by scripts/notebooks, so not committed;
# the .gitkeep files preserve the folder layout so paths never collide as it grows.
results/**
!results/**/
!results/**/.gitkeep
!results/**/*.md
*.png
*.pdf
*.svg

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/
